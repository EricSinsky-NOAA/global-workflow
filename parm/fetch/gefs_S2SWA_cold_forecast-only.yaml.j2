{% set cycle_YMDH = current_cycle | to_YMDH %}
{% set cycle_YMD = current_cycle | to_YMD %}
{% set cycle_HH = current_cycle | strftime("%H") %}
target:
    tarball : "{{ FETCHDIR }}/{{ cycle_YMDH }}/enkfgfs_grp1.tar"
    on_hpss: True
    contents:
        # select restart members files (80) specific to the cycle
        {% set mid_cyc = ("%02d" | format(previous_cycle_HH | int + half_window)) ~ "0000" %}
        {% set restart_mem_path = 'enkfgdas.' ~ previous_cycle_YMD ~ '/' ~ previous_cycle_HH ~ '/' ~ 'mem%03d' | format(gfs_member) ~ '/model/atmos/restart/' ~ previous_cycle_YMD ~ '.' ~ mid_cyc ~ '.' %}
        {% set increment_mem_path = 'enkfgfs.' ~ current_cycle_YMD ~ '/' ~ current_cycle_HH ~ '/' ~ 'mem%03d' | format(gfs_member) ~ '/analysis/atmos/enkfgfs.t' ~ current_cycle_HH ~ 'z.' %}

        # Include increment files
        {% for ftype in ["ratmi003.nc", "ratmi009.nc", "ratminc.nc"] %}
            {% set file = increment_mem_path ~ ftype %}
        - {{ file }}
        {% endfor %}

        {% set file = restart_mem_path ~ 'coupler.res' %}
        - {{ file }}
        {% set file = restart_mem_path ~ 'fv_core.res.nc' %}
        - {{ file }}
        {% set ntiles = 6 %}
        {% for ftype in ["fv_core.res", "fv_srf_wnd.res", "phy_data", "sfc_data"] %}
                # Include restart tile files (e.g., .tile1 to .tile6)
            {% for tile in range(1, ntiles + 1) %}
                {% set file = restart_mem_path ~ ftype ~ '.tile' ~ tile ~ '.nc' %}
        - {{ file }}
            {% endfor %}
        {% endfor %}

    destination: "{{ DATAROOT }}"
