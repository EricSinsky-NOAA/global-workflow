atmosphere_sfc_fix:
    mkdir:
        {% set COMOUT_ATMOS_INPUT_MEM = COMOUT_ATMOS_INPUT_MEM_list[0] %}
        - "{{ COMOUT_ATMOS_INPUT_MEM }}"
    copy:
        {% for mem in range(first_mem, last_mem + 1) %}
        {% set imem = mem - first_mem %}
        {% set COMOUT_ATMOS_RESTART_PREV_MEM = COMOUT_ATMOS_RESTART_PREV_MEM_list[imem] %}
        {% for ftype in ["sfc_data"] %}
        {% for ntile in range(1, ntiles + 1) %}
        - ["{{ ICSDIR }}/{{ ftype }}.tile{{ ntile }}.nc", "{{ COMOUT_ATMOS_RESTART_PREV_MEM }}/{{ m_prefix }}.{{ ftype }}.tile{{ ntile }}.nc"]
        {% endfor %} # ntile
        {% endfor %} # ftype
        {% endfor %} # mem loop
